#version 460

// SSR half-res upsample. The packet trace runs at half resolution and writes
// m_ssrResultHalf; this pass reconstructs a full-res reflection buffer with a
// joint-bilateral filter (normal + depth edge-stopping) so reflections don't
// bleed across silhouettes during the upscale. The SVGF denoiser downstream
// consumes the full-res output unchanged.
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D gPosition;  // full-res
layout(set = 0, binding = 1) uniform sampler2D gNormal;    // full-res
layout(set = 0, binding = 2) uniform sampler2D u_ssrHalf;  // half-res (linear)
layout(set = 0, binding = 3, rgba16f) writeonly uniform image2D u_ssrFull;

layout(push_constant) uniform PC {
    int fullW;
    int fullH;
    int halfW;
    int halfH;
} pc;

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= pc.fullW || px.y >= pc.fullH) return;
    vec2 uv = (vec2(px) + 0.5) / vec2(pc.fullW, pc.fullH);

    vec3 N = texture(gNormal, uv).rgb;
    if (dot(N, N) < 0.1) { imageStore(u_ssrFull, px, vec4(0.0)); return; }
    N = normalize(N);
    vec3 P = texture(gPosition, uv).rgb;

    // Gather the 4 nearest half-res texels around this full-res pixel and weight
    // them by bilinear footprint × normal similarity × depth proximity.
    vec2  hres      = vec2(pc.halfW, pc.halfH);
    vec2  halfTexel = 1.0 / hres;
    vec2  fcoord    = uv * hres - 0.5;
    ivec2 base      = ivec2(floor(fcoord));
    vec2  frac      = fcoord - vec2(base);

    vec4  accum = vec4(0.0);
    float wsum  = 0.0;
    for (int dy = 0; dy <= 1; ++dy)
    for (int dx = 0; dx <= 1; ++dx) {
        ivec2 q   = clamp(base + ivec2(dx, dy), ivec2(0), ivec2(pc.halfW - 1, pc.halfH - 1));
        vec2  quv = (vec2(q) + 0.5) * halfTexel;
        vec3  Nq  = texture(gNormal, quv).rgb;
        if (dot(Nq, Nq) < 0.1) continue;
        Nq = normalize(Nq);
        vec3  Pq = texture(gPosition, quv).rgb;

        float wn = pow(max(dot(N, Nq), 0.0), 32.0);
        float wd = exp(-distance(P, Pq) * 4.0);
        float wb = ((dx == 0) ? (1.0 - frac.x) : frac.x)
                 * ((dy == 0) ? (1.0 - frac.y) : frac.y);
        float w  = wn * wd * wb + 1e-4;
        accum += texture(u_ssrHalf, quv) * w;
        wsum  += w;
    }
    imageStore(u_ssrFull, px, (wsum > 0.0) ? accum / wsum : vec4(0.0));
}
