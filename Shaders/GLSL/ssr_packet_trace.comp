#version 460
#extension GL_EXT_nonuniform_qualifier : require

// SSR packet trace. Indirect-dispatched: numGroupsX = ceil(totalRayCount/256).
// Each workgroup processes 256 sorted ray entries; sorting ensures the rays
// in one workgroup share a similar reflection direction (packet coherence),
// so the shared-memory reduction below finds a tight "average direction"
// and we can promote the Hi-Z starting mip when coherence is high.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// ---- Reads ----
layout(set = 0, binding = 0) uniform sampler2D gPosition;
layout(set = 0, binding = 1) uniform sampler2D gNormal;
layout(set = 0, binding = 2) uniform sampler2D gAlbedo;
layout(set = 0, binding = 3) uniform sampler2D u_hiZ;       // mip chain
layout(set = 0, binding = 4) uniform sampler2D u_prevFrame; // previous TAA history

layout(set = 0, binding = 5, std430) readonly buffer SortedRays {
    uint sortedPixels[];
};
layout(set = 0, binding = 6, std430) readonly buffer RayCount {
    uint totalRayCount;
};

// ---- Write ----
layout(set = 0, binding = 7, rgba16f) writeonly uniform image2D u_ssrOut;

// Push constant payload: 2 mat4 (128 B) + vec4 cameraPos + 6 ints/floats = 152 B.
// Inside the 256 B minimum guaranteed by spec.
layout(push_constant) uniform PC {
    mat4  view;
    mat4  proj;
    vec4  cameraPos;
    int   width;
    int   height;
    int   hiZMipLevels;
    float maxDistance;
    float thickness;
    int   frameId;
    int   fullWidth;
    int   fullHeight;
} pc;

shared vec3  sharedDirSum[256];
shared float sharedCoherence[256];

float HashPixel(vec2 uv, float seed) {
    vec3 p = vec3(uv * 1237.0, seed * 71.0);
    p = fract(p * vec3(443.8975, 397.2973, 491.1871));
    p += dot(p, p.yzx + 19.19);
    return fract(p.x * p.y * p.z);
}

float Halton(uint i, uint b) {
    float f = 1.0;
    float r = 0.0;
    for (int k = 0; k < 16 && i > 0u; k++) {
        f /= float(b);
        r += f * float(i % b);
        i /= b;
    }
    return r;
}

vec2 HaltonCP(uint frameId, vec2 uv) {
    float h1 = Halton(frameId + 1u, 2u);
    float h2 = Halton(frameId + 1u, 3u);
    vec2 off = vec2(HashPixel(uv, 0.1), HashPixel(uv, 0.7));
    return vec2(fract(h1 + off.x), fract(h2 + off.y));
}

// Heitz 2018: VNDF GGX (isotropic, alpha = roughness²).
vec3 SampleGGXVNDF(vec3 Ve, float alpha, float u1, float u2) {
    vec3 Vh = normalize(vec3(alpha * Ve.x, alpha * Ve.y, Ve.z));
    float lensq = Vh.x * Vh.x + Vh.y * Vh.y;
    vec3 T1 = (lensq > 0.0) ? vec3(-Vh.y, Vh.x, 0.0) * inversesqrt(lensq) : vec3(1.0, 0.0, 0.0);
    vec3 T2 = cross(Vh, T1);
    float r = sqrt(u1);
    float phi = 2.0 * 3.14159265359 * u2;
    float t1 = r * cos(phi);
    float t2 = r * sin(phi);
    float s = 0.5 * (1.0 + Vh.z);
    t2 = (1.0 - s) * sqrt(1.0 - t1 * t1) + s * t2;
    vec3 Nh = t1 * T1 + t2 * T2 + sqrt(max(0.0, 1.0 - t1 * t1 - t2 * t2)) * Vh;
    return normalize(vec3(alpha * Nh.x, alpha * Nh.y, max(0.0, Nh.z)));
}

vec3 WorldToScreen(vec3 worldPos) {
    vec4 clip = pc.proj * pc.view * vec4(worldPos, 1.0);
    vec3 ndc = clip.xyz / clip.w;
    // The push-constant proj already includes the Vulkan Y-flip (matches the
    // value uploaded to the camera UBO), so NDC.y is already in Vulkan
    // convention (Y down). Map NDC.xy ([-1,1]) to UV ([0,1]) directly.
    return vec3(ndc.xy * 0.5 + 0.5, ndc.z);
}

struct RayHit {
    bool  hit;
    vec2  uv;
    float confidence;
};

RayHit TraceScreenSpaceRay(vec3 worldOrigin, vec3 worldDir, float maxDistance,
                           int maxSteps, float startMip) {
    RayHit result;
    result.hit = false;
    result.uv = vec2(0.0);
    result.confidence = 0.0;

    vec3 rayEnd = worldOrigin + worldDir * maxDistance;
    vec3 ssStart = WorldToScreen(worldOrigin);
    vec3 ssEnd = WorldToScreen(rayEnd);

    if (ssStart.z < 0.0 || ssStart.z > 1.0) return result;

    vec3 ssDir = ssEnd - ssStart;
    vec2 ssPixelDir = ssDir.xy * vec2(pc.fullWidth, pc.fullHeight);
    float pixelLength = length(ssPixelDir);

    if (pixelLength < 1.0) return result;

    int steps = min(maxSteps, int(pixelLength));
    vec3 ssStep = ssDir / float(steps);
    vec3 ssPos = ssStart + ssStep;

    float stepSizePixels = pixelLength / float(steps);
    float baseMip = max(0.0, log2(stepSizePixels));
    float mipLevel = min(max(startMip, baseMip), float(pc.hiZMipLevels - 1));

    for (int i = 0; i < steps; i++) {
        if (ssPos.x < 0.0 || ssPos.x > 1.0 || ssPos.y < 0.0 || ssPos.y > 1.0) break;
        if (ssPos.z < 0.0 || ssPos.z > 1.0) break;

        float sceneDepth = textureLod(u_hiZ, ssPos.xy, mipLevel).r;
        float depthDiff = ssPos.z - sceneDepth;

        if (depthDiff > 0.0 && depthDiff < pc.thickness) {
            result.hit = true;
            result.uv = ssPos.xy;

            vec2 edgeFade = smoothstep(vec2(0.0), vec2(0.05), ssPos.xy)
                          * smoothstep(vec2(0.0), vec2(0.05), vec2(1.0) - ssPos.xy);
            result.confidence = edgeFade.x * edgeFade.y;
            result.confidence *= 1.0 - float(i) / float(steps);
            return result;
        }

        // Skip a step when well above geometry (only at fine mips).
        if (depthDiff < -pc.thickness * 4.0 && mipLevel < 2.0) {
            ssPos += ssStep;
        }

        ssPos += ssStep;
    }

    return result;
}

void main() {
    uint rayIdx = gl_GlobalInvocationID.x;
    uint localIdx = gl_LocalInvocationID.x;
    uint workgroupRayStart = gl_WorkGroupID.x * 256u;
    uint workgroupRayCount = min(256u, totalRayCount - workgroupRayStart);
    bool isActive = (rayIdx < totalRayCount);

    vec3 R = vec3(0.0, 1.0, 0.0);
    vec3 worldPos = vec3(0.0);
    vec3 normal = vec3(0.0, 1.0, 0.0);
    float roughness = 0.5;
    float metallic = 0.0;
    float NdotV = 0.5;
    ivec2 pixel = ivec2(0);
    vec3 albedo = vec3(0.5);

    if (isActive) {
        uint packedPixel = sortedPixels[rayIdx];
        pixel = ivec2(packedPixel & 0xFFFFu, packedPixel >> 16u);
        vec2 uv = (vec2(pixel) + 0.5) / vec2(pc.width, pc.height);

        worldPos = texture(gPosition, uv).rgb;
        normal = normalize(texture(gNormal, uv).rgb);
        roughness = texture(gNormal, uv).a;
        metallic = texture(gPosition, uv).a;
        albedo = texture(gAlbedo, uv).rgb;

        vec3 V = normalize(pc.cameraPos.xyz - worldPos);
        NdotV = max(dot(normal, V), 0.0);

        vec3 up = abs(normal.y) < 0.99 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
        vec3 T = normalize(cross(up, normal));
        vec3 B = cross(normal, T);
        mat3 TBN = mat3(T, B, normal);
        vec3 V_ts = vec3(dot(V, T), dot(V, B), dot(V, normal));

        vec2 xi = HaltonCP(uint(pc.frameId), uv);
        float alpha = roughness * roughness;
        vec3 H_ts = SampleGGXVNDF(V_ts, alpha, xi.x, xi.y);
        vec3 H = TBN * H_ts;

        R = reflect(-V, H);
        if (dot(R, normal) <= 0.0) R = reflect(-V, normal);
    }

    // ---- Packet coherence reduction ----
    sharedDirSum[localIdx] = isActive ? R : vec3(0.0);
    barrier();

    for (uint s = 128u; s > 0u; s >>= 1u) {
        if (localIdx < s && localIdx + s < workgroupRayCount) {
            sharedDirSum[localIdx] += sharedDirSum[localIdx + s];
        }
        barrier();
    }

    vec3 avgDir;
    if (localIdx == 0u) {
        avgDir = normalize(sharedDirSum[0]);
        sharedDirSum[0] = avgDir;
    }
    barrier();
    avgDir = sharedDirSum[0];

    sharedCoherence[localIdx] = isActive ? dot(avgDir, R) : 1.0;
    barrier();
    for (uint s = 128u; s > 0u; s >>= 1u) {
        if (localIdx < s && localIdx + s < workgroupRayCount) {
            sharedCoherence[localIdx] = min(sharedCoherence[localIdx],
                                             sharedCoherence[localIdx + s]);
        }
        barrier();
    }
    float dirCoherence = sharedCoherence[0];

    float startMip = 0.0;
    if (dirCoherence > 0.98) startMip = 2.0;
    else if (dirCoherence > 0.95) startMip = 1.0;

    if (!isActive) return;

    float maxDist = pc.maxDistance * (1.0 - roughness * roughness);

    float eyeDepth = max(0.01, -(pc.view * vec4(worldPos, 1.0)).z);
    float pixelFootprint = eyeDepth * 2.0 / float(pc.height);
    vec3 origin = worldPos + normal * max(pixelFootprint * 2.0, 0.01);

    RayHit hit = TraceScreenSpaceRay(origin, R, maxDist, 48, startMip);

    if (hit.hit) {
        vec3 nHit = texture(gNormal, hit.uv).rgb;
        if (length(nHit) > 0.1 && dot(normalize(nHit), R) > 0.0) {
            hit.hit = false;
        }
    }

    vec4 ssrResult = vec4(0.0);
    if (hit.hit) {
        vec3 reflectedColor = texture(u_prevFrame, hit.uv).rgb;
        vec3 F0 = mix(vec3(0.04), albedo, metallic);
        // Fresnel WITH roughness (matches lighting.frag's IBL term): rough
        // surfaces don't spike to full reflectance at grazing angles, so mate
        // dielectrics no longer pick up a strong sky-tinted rim from SSR.
        vec3 Fmax = max(vec3(1.0 - roughness), F0);
        vec3 F = F0 + (Fmax - F0) * pow(clamp(1.0 - NdotV, 0.0, 1.0), 5.0);
        reflectedColor *= F;
        float roughFade = smoothstep(0.70, 0.05, roughness);
        float angleFade = smoothstep(0.15, 0.4, NdotV);
        ssrResult = vec4(reflectedColor, hit.confidence * roughFade * angleFade);
    }

    imageStore(u_ssrOut, pixel, ssrResult);
}
