#version 460

// SVGF spatial A-Trous wavelet pass. Iterated 3 times with stepSize 1, 2, 4
// (separate pipelines NOT required — stepSize comes in via push constant).
// Each iteration is a 5×5 cross-bilateral filter whose luminance-stopping
// sigma is scaled by the per-pixel variance from the temporal pass —
// noisy pixels get blurred more, clean pixels keep detail.
//
// Bindings:
//   0 — input color  (RGBA16F): RGB color, A confidence
//   1 — moments      (RGBA16F): R=moment1, G=moment2, B=histLen, A=variance
//   2 — gNormal      (for edge-stopping)
//   3 — gPosition    (for edge-stopping)
//   4 — output color (storage image)

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D u_inColor;
layout(set = 0, binding = 1) uniform sampler2D u_moments;
layout(set = 0, binding = 2) uniform sampler2D u_gNormal;
layout(set = 0, binding = 3) uniform sampler2D u_gPosition;
layout(set = 0, binding = 4, rgba16f) writeonly uniform image2D u_outColor;

layout(push_constant) uniform PC {
    int   width;
    int   height;
    int   stepSize;       // 1, 2, 4
    int   finalIteration; // 1 = apply firefly compression at the end
    float sigmaLuminance;
    float sigmaNormal;
    float sigmaDepth;
    float _pad0;
} pc;

float Luminance(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

// 5×5 A-Trous wavelet kernel weights as the separable 1D kernel
// [1/16, 1/4, 3/8, 1/4, 1/16] — stored normalized so the |0| entry is 1.0.
const float kernel[3] = float[3](1.0, 2.0 / 3.0, 1.0 / 6.0);

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= pc.width || pixel.y >= pc.height) return;

    vec2 uv = (vec2(pixel) + 0.5) / vec2(pc.width, pc.height);
    vec2 texelSize = 1.0 / vec2(pc.width, pc.height);

    vec4  centerData       = texture(u_inColor, uv);
    vec3  centerColor      = centerData.rgb;
    float centerConfidence = centerData.a;
    float centerLum        = Luminance(centerColor);

    vec3  centerNormal = normalize(texture(u_gNormal, uv).rgb);
    vec3  centerPos    = texture(u_gPosition, uv).rgb;
    float centerDepth  = length(centerPos);

    vec4  momentsData = texture(u_moments, uv);
    float variance    = momentsData.a;
    float historyLen  = momentsData.b;

    // Background pixels: pass through, no filter.
    if (length(texture(u_gNormal, uv).rgb) < 0.1) {
        imageStore(u_outColor, pixel, vec4(centerColor, centerConfidence));
        return;
    }

    // Variance-guided luminance sigma. Floor it when variance is nonzero
    // so we always apply *some* filter — otherwise low-variance noisy
    // pixels survive forever.
    float varianceSqrt = sqrt(max(variance, 1e-6));
    float sigmaL = pc.sigmaLuminance * varianceSqrt;
    sigmaL = max(sigmaL, variance > 0.01 ? 0.05 : 1e-6);
    if (historyLen < 8.0) {
        sigmaL *= mix(3.0, 1.0, historyLen / 8.0);
    }

    vec3  sumColor      = centerColor * kernel[0] * kernel[0];
    float sumConfidence = centerConfidence * kernel[0] * kernel[0];
    float sumWeight     = kernel[0] * kernel[0];

    for (int dy = -2; dy <= 2; ++dy) {
        for (int dx = -2; dx <= 2; ++dx) {
            if (dx == 0 && dy == 0) continue;
            vec2 sUV = uv + vec2(dx, dy) * texelSize * float(pc.stepSize);
            if (sUV.x < 0.0 || sUV.x > 1.0 || sUV.y < 0.0 || sUV.y > 1.0) continue;

            float kw = kernel[abs(dx)] * kernel[abs(dy)];

            vec4  sData       = texture(u_inColor, sUV);
            vec3  sColor      = sData.rgb;
            float sConfidence = sData.a;
            float sLum        = Luminance(sColor);

            vec3 sNormal = texture(u_gNormal, sUV).rgb;
            vec3 sPos    = texture(u_gPosition, sUV).rgb;
            if (length(sNormal) < 0.1) continue;
            sNormal = normalize(sNormal);

            float normalDist = max(1.0 - dot(centerNormal, sNormal), 0.0);
            float wNormal    = exp(-normalDist / (pc.sigmaNormal * pc.sigmaNormal + 1e-6));

            float sDepth    = length(sPos);
            float depthDist = abs(centerDepth - sDepth);
            float wDepth    = exp(-depthDist / (pc.sigmaDepth * max(centerDepth, 0.01) + 1e-6));

            float lumDist     = abs(centerLum - sLum);
            float wLuminance  = exp(-lumDist / (sigmaL + 1e-6));

            float w = kw * wNormal * wDepth * wLuminance;
            sumColor      += sColor      * w;
            sumConfidence += sConfidence * w;
            sumWeight     += w;
        }
    }

    vec3  resultColor      = sumColor      / max(sumWeight, 1e-6);
    float resultConfidence = sumConfidence / max(sumWeight, 1e-6);

    // Firefly compression — applied only on the final iteration so the
    // A-Trous edge-stopping weights compute correctly on linear HDR input.
    if (pc.finalIteration == 1) {
        float resultLum = Luminance(resultColor);
        resultColor *= 1.0 / (1.0 + resultLum * 0.1);
    }

    imageStore(u_outColor, pixel, vec4(resultColor, resultConfidence));
}
