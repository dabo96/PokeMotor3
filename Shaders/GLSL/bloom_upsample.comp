#version 450

// Bloom upsample: 9-tap tent filter (Sledgehammer / Karis). Reads from the
// next-smaller mip (u_srcUp) and adds it to the equivalent down-chain mip
// (u_srcDown) to produce the current up-chain mip.
//
//   1 2 1
//   2 4 2     × 1/16
//   1 2 1
//
// At the first upsample iteration (deepest mip), the down-chain sample IS
// the input — the host passes the same chain image bound to both binding
// points and the resulting addition is just doubling (with intent: that
// deepest mip needs the most "bloom strength"). For subsequent iters the
// up-chain accumulates.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D u_srcUp;     // mip above (smaller)
layout(set = 0, binding = 1) uniform sampler2D u_srcDown;   // mip at this resolution (down chain)
layout(set = 0, binding = 2, rgba16f) writeonly uniform image2D u_dst;

layout(push_constant) uniform PC {
    int   dstWidth;
    int   dstHeight;
    float filterRadius;   // in source-texel units, typically 1.0
    float intensity;      // upsample bloom contribution mix factor [0..1]
} pc;

void main() {
    ivec2 dst = ivec2(gl_GlobalInvocationID.xy);
    if (dst.x >= pc.dstWidth || dst.y >= pc.dstHeight) return;

    vec2 uv = (vec2(dst) + 0.5) / vec2(pc.dstWidth, pc.dstHeight);
    vec2 srcTexel = pc.filterRadius / vec2(textureSize(u_srcUp, 0));

    // Tent filter on the smaller-mip input.
    vec3 a = texture(u_srcUp, uv + srcTexel * vec2(-1.0, -1.0)).rgb;
    vec3 b = texture(u_srcUp, uv + srcTexel * vec2( 0.0, -1.0)).rgb;
    vec3 c = texture(u_srcUp, uv + srcTexel * vec2( 1.0, -1.0)).rgb;
    vec3 d = texture(u_srcUp, uv + srcTexel * vec2(-1.0,  0.0)).rgb;
    vec3 e = texture(u_srcUp, uv).rgb;
    vec3 f = texture(u_srcUp, uv + srcTexel * vec2( 1.0,  0.0)).rgb;
    vec3 g = texture(u_srcUp, uv + srcTexel * vec2(-1.0,  1.0)).rgb;
    vec3 h = texture(u_srcUp, uv + srcTexel * vec2( 0.0,  1.0)).rgb;
    vec3 i = texture(u_srcUp, uv + srcTexel * vec2( 1.0,  1.0)).rgb;

    vec3 up = (a + 2.0 * b + c +
               2.0 * d + 4.0 * e + 2.0 * f +
               g + 2.0 * h + i) / 16.0;

    vec3 downSample = texture(u_srcDown, uv).rgb;
    vec3 result = mix(downSample, up, pc.intensity);
    imageStore(u_dst, dst, vec4(result, 1.0));
}
