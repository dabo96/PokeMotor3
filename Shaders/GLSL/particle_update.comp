#version 460

// Per-particle physics + lifecycle. One thread per particle. Identical
// layout/behaviour to the OpenGL Shaders/particle_update.comp port — same
// 80-byte struct so the host C++ side matches without re-design.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

struct Particle {
    vec4 position;   // xyz = pos, w = current size
    vec4 velocity;   // xyz = vel, w = lifetime remaining
    vec4 color;      // rgba — host pre-fills with start color
    vec4 params;     // x = maxLifetime, y = startSize, z = endSize, w = alive(1)/dead(0)
    vec4 extra;      // xyz = gravity, w = unused
};

layout(set = 0, binding = 0, std430) buffer ParticleBuffer {
    Particle particles[];
};

layout(push_constant) uniform PC {
    float dt;
    int   count;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= uint(pc.count)) return;

    Particle p = particles[idx];
    if (p.params.w < 0.5) return;  // dead

    p.velocity.w -= pc.dt;
    if (p.velocity.w <= 0.0) {
        p.params.w = 0.0;
        particles[idx] = p;
        return;
    }

    p.velocity.xyz += p.extra.xyz * pc.dt;
    p.position.xyz += p.velocity.xyz * pc.dt;

    float t = 1.0 - (p.velocity.w / max(p.params.x, 1e-4));
    p.position.w = mix(p.params.y, p.params.z, t);
    p.color.a    = 1.0 - t * t;  // quadratic fade

    particles[idx] = p;
}
